# Copiez ce fichier en .env et changez les valeurs.

# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=change-moi

# Secret de signature des jetons (32 caractères minimum) :
#   openssl rand -base64 48
JWT_SECRET=change-moi-change-moi-change-moi-change-moi

# Port de l'application sur la machine
WEB_PORT=8088

# true : crée une société et des comptes de démonstration au premier démarrage (mot de passe demo1234)
# À mettre à false en production
DEMO_DATA=true

# true si l'application est servie en HTTPS (cookie de session « Secure »)
COOKIE_SECURE=false

# ── MinIO (stockage des fichiers) ──
# Compte administrateur : console http://localhost:9001 (depuis cette machine seulement)
MINIO_ROOT_USER=ged-admin
MINIO_ROOT_PASSWORD=change-moi-minio
# Compte utilisé par l'application (lecture/écriture, sans suppression), créé automatiquement
S3_ACCESS_KEY=ged-app
S3_SECRET_KEY=change-moi-s3-secret
S3_BUCKET=ged-documents
# Compte de destruction (exécution des bordereaux d'élimination visés), créé automatiquement
S3_DISPOSAL_ACCESS_KEY=ged-disposal
S3_DISPOSAL_SECRET_KEY=change-moi-destruction
# Compte de sauvegarde (lecture seule), créé automatiquement
S3_BACKUP_ACCESS_KEY=ged-backup
S3_BACKUP_SECRET_KEY=change-moi-sauvegarde

# ── Sauvegardes ──
# Dossier de destination sur la machine : idéalement un autre disque (ex. E:/sauvegardes-ged)
BACKUP_DIR=./backups
# Planification (format cron, fuseau TZ) : tous les jours à 2 h
BACKUP_CRON=0 2 * * *
TZ=Europe/Paris
# Nombre de jours de conservation des dumps de la base
BACKUP_KEEP_DAYS=14
# true : une sauvegarde aussi à chaque démarrage du service
BACKUP_ON_START=true
