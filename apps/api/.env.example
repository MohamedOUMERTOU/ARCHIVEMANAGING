# Base PostgreSQL (docker compose : port 5433, utilisateur/mot de passe ged)
DATABASE_URL="postgresql://ged:ged@localhost:5433/ged?schema=public"

# Secret de signature des jetons JWT : à changer en production
JWT_SECRET="change-moi"
JWT_EXPIRES_IN="8h"

# Dossier de stockage des fichiers (stockage local)
STORAGE_DIR="./storage"

PORT=3000
