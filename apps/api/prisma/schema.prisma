// GED — schéma de données, phase 1 (noyau)
// Toutes les tables métier portent organization_id : chaque société est isolée.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Société ─────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  users          User[]
  roles          Role[]
  nodes          ClassificationNode[]
  documentTypes  DocumentType[]
  retentionRules RetentionRule[]
  documents      Document[]
  tags           Tag[]
  locationLevels LocationLevel[]
  locations      PhysicalLocation[]

  @@map("organizations")
}

// ───────────── Sécurité ─────────────

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  active         Boolean  @default(true)
  isSuperAdmin   Boolean  @default(false) @map("is_super_admin")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  roles        UserRole[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  // Permissions générales, ex. "settings.manage", "physical.manage", "audit.read"
  permissions    String[] @default([])

  organization    Organization     @relation(fields: [organizationId], references: [id])
  users           UserRole[]
  nodePermissions NodePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Droits d'un rôle sur un nœud du plan de classement (hérités par les sous-nœuds)
model NodePermission {
  id        String  @id @default(uuid()) @db.Uuid
  roleId    String  @map("role_id") @db.Uuid
  nodeId    String  @map("node_id") @db.Uuid
  canRead   Boolean @default(true) @map("can_read")
  canWrite  Boolean @default(false) @map("can_write")
  canDelete Boolean @default(false) @map("can_delete")
  canAdmin  Boolean @default(false) @map("can_admin")

  role Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  node ClassificationNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([roleId, nodeId])
  @@map("node_permissions")
}

// ───────────── Plan de classement ─────────────

enum NodeType {
  FONDS
  SERIE
  SOUS_SERIE
  DOSSIER
}

model ClassificationNode {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  type            NodeType
  code            String
  title           String
  description     String?
  // Chemin d'ID, ex. "/<id fonds>/<id série>/<id>/" : recalculé seulement en cas de déplacement
  idPath          String    @map("id_path")
  depth           Int
  retentionRuleId String?   @map("retention_rule_id") @db.Uuid
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization       @relation(fields: [organizationId], references: [id])
  parent        ClassificationNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children      ClassificationNode[] @relation("NodeTree")
  retentionRule RetentionRule?       @relation(fields: [retentionRuleId], references: [id])
  documents     Document[]
  permissions   NodePermission[]

  @@unique([organizationId, code])
  @@index([organizationId, idPath])
  @@map("classification_nodes")
}

// ───────────── Conservation ─────────────

enum StartEvent {
  DATE_DOCUMENT
  CLOTURE_DOSSIER
  DATE_CREATION
}

enum FinalAction {
  CONSERVER
  DETRUIRE
  VERSER
}

model RetentionRule {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String
  // null = conservation illimitée
  durationYears    Int?        @map("duration_years")
  startEvent       StartEvent  @map("start_event")
  finalAction      FinalAction @map("final_action")
  legalBasis       String?     @map("legal_basis")
  requiresApproval Boolean     @default(true) @map("requires_approval")

  organization  Organization         @relation(fields: [organizationId], references: [id])
  nodes         ClassificationNode[]
  documentTypes DocumentType[]

  @@unique([organizationId, name])
  @@map("retention_rules")
}

// ───────────── Documents ─────────────

model DocumentType {
  id                     String  @id @default(uuid()) @db.Uuid
  organizationId         String  @map("organization_id") @db.Uuid
  code                   String
  name                   String
  // Liste des champs : [{ key, label, type, required, searchable, options? }]
  metadataSchema         Json    @default("[]") @map("metadata_schema")
  defaultRetentionRuleId String? @map("default_retention_rule_id") @db.Uuid
  ocrEnabled             Boolean @default(true) @map("ocr_enabled")

  organization         Organization   @relation(fields: [organizationId], references: [id])
  defaultRetentionRule RetentionRule? @relation(fields: [defaultRetentionRuleId], references: [id])
  documents            Document[]

  @@unique([organizationId, code])
  @@map("document_types")
}

enum DocumentStatus {
  A_CLASSER
  ACTIVE
  INTERMEDIAIRE
  DEFINITIF
  A_ELIMINER
  ELIMINE
  VERSE
}

model Document {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  // null tant que le document est « à classer »
  nodeId             String?        @map("node_id") @db.Uuid
  typeId             String?        @map("type_id") @db.Uuid
  title              String
  // Cote : attribuée au classement
  reference          String?
  documentDate       DateTime?      @map("document_date") @db.Date
  metadata           Json           @default("{}")
  status             DocumentStatus @default(A_CLASSER)
  retentionUntil     DateTime?      @map("retention_until") @db.Date
  legalHold          Boolean        @default(false) @map("legal_hold")
  physicalLocationId String?        @map("physical_location_id") @db.Uuid
  createdById        String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization     Organization        @relation(fields: [organizationId], references: [id])
  node             ClassificationNode? @relation(fields: [nodeId], references: [id])
  type             DocumentType?       @relation(fields: [typeId], references: [id])
  physicalLocation PhysicalLocation?   @relation(fields: [physicalLocationId], references: [id])
  versions         DocumentVersion[]
  tags             DocumentTag[]
  events           DocumentEvent[]
  aliases          DocumentAlias[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([nodeId])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionNo      Int      @map("version_no")
  storageKey     String   @map("storage_key")
  filename       String
  mimeType       String   @map("mime_type")
  size           Int
  sha256         String
  ocrText        String?  @map("ocr_text")
  // Motif du remplacement de la version précédente
  replaceReason  String?  @map("replace_reason")
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, versionNo])
  @@index([sha256])
  @@map("document_versions")
}

// Ancienne cote après un reclassement : elle mène toujours au document
model DocumentAlias {
  organizationId String   @map("organization_id") @db.Uuid
  oldReference   String   @map("old_reference")
  documentId     String   @map("document_id") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at")

  document Document @relation(fields: [documentId], references: [id])

  @@id([organizationId, oldReference])
  @@map("document_aliases")
}

model Tag {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  description    String?
  color          String  @default("#566170")
  restricted     Boolean @default(false)

  organization Organization  @relation(fields: [organizationId], references: [id])
  documents    DocumentTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model DocumentTag {
  documentId String @map("document_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags")
}

// ───────────── Archives physiques dynamiques ─────────────

model LocationLevel {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  code             String
  name             String
  isRoot           Boolean @default(false) @map("is_root")
  canHoldDocuments Boolean @default(false) @map("can_hold_documents")
  capacity         Int?
  attributesSchema Json    @default("[]") @map("attributes_schema")

  organization Organization         @relation(fields: [organizationId], references: [id])
  children     LocationLevelChild[] @relation("ParentLevel")
  parents      LocationLevelChild[] @relation("ChildLevel")
  locations    PhysicalLocation[]

  @@unique([organizationId, code])
  @@map("location_levels")
}

// « Le niveau parent peut contenir le niveau enfant »
model LocationLevelChild {
  parentLevelId String @map("parent_level_id") @db.Uuid
  childLevelId  String @map("child_level_id") @db.Uuid

  parentLevel LocationLevel @relation("ParentLevel", fields: [parentLevelId], references: [id], onDelete: Cascade)
  childLevel  LocationLevel @relation("ChildLevel", fields: [childLevelId], references: [id], onDelete: Cascade)

  @@id([parentLevelId, childLevelId])
  @@map("location_level_children")
}

model PhysicalLocation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  levelId        String  @map("level_id") @db.Uuid
  parentId       String? @map("parent_id") @db.Uuid
  code           String
  label          String
  barcode        String?
  idPath         String  @map("id_path")
  depth          Int
  attributes     Json    @default("{}")
  active         Boolean @default(true)

  organization Organization       @relation(fields: [organizationId], references: [id])
  level        LocationLevel      @relation(fields: [levelId], references: [id])
  parent       PhysicalLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children     PhysicalLocation[] @relation("LocationTree")
  documents    Document[]

  @@unique([organizationId, code])
  @@index([organizationId, idPath])
  @@map("physical_locations")
}

// ───────────── Traçabilité ─────────────

enum DocumentEventType {
  CREE
  CLASSE
  CONSULTE
  TELECHARGE
  COPIE_DEMANDEE
  COPIE_REMISE
  ORIGINAL_DEMANDE
  ORIGINAL_SORTI
  ORIGINAL_RENDU
  RECLASSE
  VERSION_REMPLACEE
  METADONNEES_MODIFIEES
  RANGE
  DEPLACE
  GEL_POSE
  GEL_LEVE
  VERSE
  ELIMINE
}

// Historique propre à chaque document, en ajout seul
model DocumentEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  documentId     String            @map("document_id") @db.Uuid
  type           DocumentEventType
  actorId        String?           @map("actor_id") @db.Uuid
  onBehalfOf     String?           @map("on_behalf_of")
  reason         String?
  before         Json?
  after          Json?
  relatedType    String?           @map("related_type")
  relatedId      String?           @map("related_id")
  at             DateTime          @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId, at])
  @@map("document_events")
}

// Journal général, en ajout seul et chaîné : chaque entrée contient l'empreinte de la précédente
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  details        Json     @default("{}")
  ip             String?
  at             DateTime @default(now())
  prevHash       String?  @map("prev_hash")
  hash           String

  @@index([organizationId, at])
  @@map("audit_log")
}
